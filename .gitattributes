# 默认让 Git 自动识别文本文件，仓库内统一存 LF
* text=auto

# 源码保持 LF
*.c      text eol=lf
*.h      text eol=lf
*.s      text eol=lf
*.md     text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Keil/uVision 工程文件在 Windows 下用 CRLF，避免每次保存产生整文件 diff
*.uvprojx text eol=crlf
*.uvoptx  text eol=crlf
*.sct     text eol=crlf

# 二进制文件不要做换行转换
*.axf  binary
*.hex  binary
*.o    binary
*.lib  binary
*.bin  binary
